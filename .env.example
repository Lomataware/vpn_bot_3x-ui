# ===== BOT =====
BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here
ADMIN_ID=123456789
ADDITIONAL_ADMINS=

# ===== SUPPORT =====
SUPPORT_USERNAME=support
SUPPORT_PHONE=+79000000000
BANK_NAME=Т-Банк (СБП)

# ===== 3X-UI =====
XUI_URL=https://127.0.0.1:2053
XUI_USERNAME=admin
XUI_PASSWORD=your_xui_password
XUI_INBOUND_ID=1
# Hysteria2: 0 = бот сам найдет/создаст hysteria2-инбаунд (рекомендуется)
XUI_ENABLE_HYSTERIA=true
XUI_HYSTERIA_INBOUND_ID=0
XUI_HYSTERIA_PORT=443
XUI_PUBLIC_HOST=vpn.example.com
XUI_SUB_URL=https://vpn.example.com:2096/sub
DEFAULT_DATA_LIMIT_GB=100
LIMIT_IP=0
SERVER_LABEL=Main

# ===== CRYPTOBOT =====
CRYPTOBOT_TOKEN=
CRYPTOBOT_ENABLED=false
CRYPTOBOT_TESTNET=true

# ===== TRIAL & PRICES =====
TRIAL_DAYS=3
PRICE_1_MONTH=100
# Сколько дней дает тариф «1 месяц» (30 = ровно 30 дней, а не календарный месяц)
MONTH_DAYS=30
